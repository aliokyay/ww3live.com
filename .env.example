# ====================================================================
# WW3 Live Radar - Environment Variables Template
# Copy this file to '.env' for local development or configure these
# variables in your Netlify dashboard (Site configuration -> Environment variables).
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB!
# ====================================================================

# --- Firebase Configuration (Frontend - Vite) ---
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id_here"
VITE_FIREBASE_APP_ID="your_firebase_app_id_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="your_firestore_database_id_here"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_here"
VITE_FIREBASE_MEASUREMENT_ID=""

# --- RSS News Feed API Key (Optional, for higher rate limits) ---
VITE_RSS2JSON_API_KEY=""

# --- Nominatim / OpenStreetMap Geocoding Contact (Email or URL for User-Agent) ---
VITE_NOMINATIM_EMAIL="contact@ww3live.org"

# --- Gemini AI API Key (Backend - Node.js) ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- App URL (Automated in cloud hosting) ---
APP_URL="http://localhost:3000"
